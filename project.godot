; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Last Terminus"
config/description="A first-person slapstick horror-comedy about fate, chain-reaction accidents and one extremely difficult-to-kill dog."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=0
boot_splash/bg_color=Color(0.03, 0.035, 0.04, 1)
boot_splash/show_image=false
config/icon="res://ui/icon.svg"

[audio]

buses/default_bus_layout=""
driver/enable_input=false

[autoload]

Events="*res://systems/events.gd"
GameState="*res://systems/game_state.gd"
SettingsManager="*res://systems/settings_manager.gd"
InputGlyphs="*res://systems/input_glyphs.gd"
AudioManager="*res://systems/audio_manager.gd"
DialogueManager="*res://systems/dialogue_manager.gd"
SequenceManager="*res://systems/sequence_manager.gd"
AchievementManager="*res://systems/achievement_manager.gd"
SaveManager="*res://systems/save_manager.gd"
FX="*res://systems/fx_manager.gd"
Director="*res://systems/director.gd"
DebugTools="*res://systems/debug_tools.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/custom_font=""

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

3d_render/layer_1="world"
3d_render/layer_2="viewmodel"
3d_render/layer_3="premonition_only"
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="pickles"
3d_physics/layer_4="npc"
3d_physics/layer_5="props"
3d_physics/layer_6="interact"
3d_physics/layer_7="lethal"
3d_physics/layer_8="trigger"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
3d/default_gravity=9.8
3d/solver/default_contact_bias=0.4
common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=true
anti_aliasing/screen_space_roughness_limiter/enabled=true
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=2
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.025, 1)
global_illumination/sdfgi/probe_ray_count=1
global_illumination/gi/use_half_resolution=true
reflections/sky_reflections/roughness_layers=6
camera/depth_of_field/depth_of_field_bokeh_shape=0
camera/depth_of_field/depth_of_field_bokeh_quality=1
scaling_3d/mode=0

[navigation]

3d/default_cell_size=0.2
3d/default_cell_height=0.12
3d/default_edge_connection_margin=0.5
3d/merge_rasterizer_cell_scale=1.0
